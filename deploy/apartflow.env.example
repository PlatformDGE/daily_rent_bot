# /etc/apartflow.env — настройки сервера ApartFlow (не коммитить с реальными значениями!)
NODE_ENV=production
PORT=3077
HOST=127.0.0.1
DB_FILE=/opt/apartflow/data/apartflow.db
BACKUP_DIR=/opt/apartflow/backups
BACKUP_KEEP=30

# Токен бота от @BotFather (НОВЫЙ, после /revoke старого)
BOT_TOKEN=
# Где лежит мини-приложение (GitHub Pages)
WEBAPP_URL=https://platformdge.github.io/daily_rent_bot/
# Кому разрешён доступ: Telegram ID через запятую (узнать — команда /myid в боте)
ALLOWED_TG_IDS=
# Откуда разрешены запросы к API
ALLOWED_ORIGINS=https://platformdge.github.io
# Токен для служебного доступа (curl/скрипты). Генерируется setup.sh
ADMIN_TOKEN=
